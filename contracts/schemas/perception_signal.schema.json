{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/perception_signal.schema.json",
  "title": "Perception Signal",
  "description": "A bounded observation with provenance, confidence, TTL and consent scope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "signal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "modality": {
      "type": "string",
      "enum": [
        "audio",
        "text",
        "video",
        "screen",
        "interaction",
        "technical"
      ]
    },
    "signal_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "observed_value_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50000,
      "contentMediaType": "application/json"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent_scope": {
      "type": "string",
      "enum": [
        "essential_processing",
        "recording",
        "behavioral_analysis",
        "emotion_inference",
        "biometric_identity",
        "technical_quality"
      ]
    },
    "allowed_use": {
      "type": "string",
      "enum": [
        "turn_taking",
        "accessibility",
        "quality",
        "personalization",
        "safety",
        "prohibited"
      ]
    }
  },
  "required": [
    "schema_version",
    "signal_id",
    "session_id",
    "tenant_id",
    "modality",
    "signal_type",
    "observed_value_json",
    "source",
    "confidence",
    "evidence_ref",
    "occurred_at",
    "expires_at",
    "consent_scope",
    "allowed_use"
  ]
}
