{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/fake_provider_journal_entry.schema.json",
  "title": "Deterministic Fake Provider Journal Entry",
  "description": "Non-PII local marker for replaying fake provider timing, partials, completion and terminal failures.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "port_kind": {
      "type": "string",
      "enum": ["channel", "realtime_model", "stt", "tts", "avatar", "meeting", "telephony", "tool", "storage"]
    },
    "operation": { "$ref": "https://schemas.axtro.ai/v2/fake_provider_scenario.schema.json#/$defs/fake_provider_operation" },
    "invocation": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "phase": { "type": "string", "enum": ["started", "partial", "completed", "failed", "cancelled", "timed_out"] },
    "simulated_at_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "failure_code": {
      "type": ["string", "null"],
      "enum": [
        null, "invalid_configuration", "authentication", "rate_limited", "capacity", "timeout", "transient_network",
        "provider_internal", "unsupported_capability", "policy_blocked", "budget_blocked", "cancelled", "unknown"
      ]
    }
  },
  "required": ["schema_version", "port_kind", "operation", "invocation", "sequence", "phase", "simulated_at_ms", "failure_code"]
}
