{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/handoff_packet.schema.json",
  "title": "Handoff Packet",
  "description": "Context package for an atomic presenter transfer to a human.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "from_presenter_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "specific_human",
        "team_queue",
        "specialist_human",
        "fallback_queue"
      ]
    },
    "target_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "urgent"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "customer_context_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100000,
      "contentMediaType": "application/json"
    },
    "role_state_snapshot_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200000,
      "contentMediaType": "application/json"
    },
    "actions_completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 100
    },
    "open_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 100
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "handoff_id",
    "session_id",
    "tenant_id",
    "from_presenter_id",
    "target_type",
    "target_id",
    "reason_code",
    "priority",
    "summary",
    "customer_context_json",
    "role_state_snapshot_json",
    "actions_completed",
    "open_actions",
    "requested_at",
    "expires_at"
  ]
}
