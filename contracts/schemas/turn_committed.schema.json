{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/turn_committed.schema.json",
  "title": "Canonical Committed Turn Payload",
  "description": "Restricted canonical payload for a participant or Presenter turn. Participant turns carry no generation, while Presenter turns carry one positive generation ID.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "speaker_participant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "speaker_role": {
      "type": "string",
      "enum": ["participant", "presenter"]
    },
    "transcript_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "^[^\\u0000]+$"
    },
    "generation_id": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "turn_index": {
      "type": "integer",
      "minimum": 1
    },
    "active_topic": {
      "type": ["string", "null"],
      "maxLength": 300
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 50
    },
    "confirmed_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "explicit_user_statement",
              "tool_verified",
              "knowledge_source",
              "derived_hypothesis",
              "operator_input",
              "system_observation"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": [
          "evidence_id",
          "kind",
          "summary",
          "source_ref",
          "confidence",
          "observed_at",
          "expires_at"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "repair_state": {
      "type": "string",
      "enum": [
        "none",
        "clarifying",
        "recovering_interruption",
        "recovering_tool_failure",
        "recovering_connection"
      ]
    },
    "incremental_summary": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "schema_version",
    "speaker_participant_id",
    "speaker_role",
    "transcript_text",
    "generation_id",
    "turn_index",
    "active_topic",
    "language",
    "open_questions",
    "confirmed_facts",
    "repair_state",
    "incremental_summary"
  ],
  "if": {
    "properties": {
      "speaker_role": {
        "const": "participant"
      }
    },
    "required": [
      "speaker_role"
    ]
  },
  "then": {
    "properties": {
      "generation_id": {
        "type": "null"
      }
    },
    "required": [
      "generation_id"
    ]
  },
  "else": {
    "properties": {
      "generation_id": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "generation_id"
    ]
  }
}
