{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/workflow_status.schema.json",
  "title": "Workflow Status",
  "description": "Persistent status of a durable workflow execution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "workflow_run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting",
        "completed",
        "failed",
        "cancelled",
        "compensating"
      ]
    },
    "current_step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "last_error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "retryable": {
              "type": "boolean"
            },
            "provider_code": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "provider_code"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "workflow_run_id",
    "command_id",
    "tenant_id",
    "status",
    "current_step",
    "attempts",
    "last_error",
    "started_at",
    "updated_at",
    "completed_at"
  ]
}
