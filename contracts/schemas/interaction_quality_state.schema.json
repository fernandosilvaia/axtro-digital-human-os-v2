{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/interaction_quality_state.schema.json",
  "title": "Interaction Quality State",
  "description": "Multi-dimensional interaction quality state. It is not a hidden trust score.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "clarity",
              "explicit_interest",
              "engagement",
              "resistance",
              "urgency",
              "next_step_readiness",
              "relationship_continuity",
              "system_confidence"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 0,
            "maxItems": 50
          },
          "rationale": {
            "type": "string",
            "maxLength": 500
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "value",
          "confidence",
          "evidence_refs",
          "rationale",
          "updated_at",
          "expires_at"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "aggregate_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "tenant_id",
    "dimensions",
    "aggregate_confidence",
    "updated_at"
  ]
}
