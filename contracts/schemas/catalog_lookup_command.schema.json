{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/catalog_lookup_command.schema.json",
  "title": "Catalog Lookup Command",
  "description": "Structured request for the server-owned catalog lookup coordinator. It has no execution authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "plan_id": {
      "type": "string",
      "enum": ["starter", "growth"]
    }
  },
  "required": ["schema_version", "question_id", "session_id", "plan_id"]
}
