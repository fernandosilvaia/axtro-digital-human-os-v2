{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/behavior_directive.schema.json",
  "title": "Behavior Directive",
  "description": "Deterministic, bounded presentation behavior for the active Presenter.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "directive_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_presenter_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "posture": {
      "type": "string",
      "enum": [
        "neutral",
        "listening",
        "explaining",
        "presenting",
        "handoff"
      ]
    },
    "facial_expression": {
      "type": "string",
      "enum": [
        "neutral_warm",
        "attentive",
        "light_smile",
        "concerned",
        "confident",
        "none"
      ]
    },
    "gaze": {
      "type": "string",
      "enum": [
        "camera",
        "participant",
        "content",
        "neutral"
      ]
    },
    "gesture": {
      "type": "string",
      "enum": [
        "none",
        "micro_nod",
        "single_nod",
        "open_hand",
        "settle"
      ]
    },
    "vocal_style": {
      "type": "string",
      "enum": [
        "neutral",
        "warm",
        "calm",
        "energetic",
        "reassuring",
        "concise"
      ]
    },
    "pause_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "directive_id",
    "session_id",
    "tenant_id",
    "target_presenter_id",
    "posture",
    "facial_expression",
    "gaze",
    "gesture",
    "vocal_style",
    "pause_ms",
    "duration_ms",
    "reason",
    "priority",
    "generated_at",
    "expires_at"
  ]
}
