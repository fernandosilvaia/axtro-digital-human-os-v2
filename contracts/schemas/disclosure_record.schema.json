{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/disclosure_record.schema.json",
  "title": "Disclosure Record",
  "description": "Evidence that a required disclosure was delivered and optionally acknowledged.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "disclosure_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "disclosure_type": {
      "type": "string",
      "enum": [
        "ai_identity",
        "recording",
        "data_use",
        "regulated_scope",
        "marketing_contact"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery_channel": {
      "type": "string",
      "enum": [
        "spoken",
        "visual",
        "chat",
        "email",
        "signed_document"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "acknowledged": {
      "type": "boolean"
    },
    "acknowledged_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "disclosure_id",
    "session_id",
    "tenant_id",
    "disclosure_type",
    "version",
    "content_hash",
    "delivery_channel",
    "language",
    "delivered_at",
    "acknowledged",
    "acknowledged_at"
  ]
}
