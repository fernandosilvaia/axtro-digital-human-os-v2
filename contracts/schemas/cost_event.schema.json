{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/cost_event.schema.json",
  "title": "Cost Event",
  "description": "Atomic cost ledger entry attributable to tenant and optionally session.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "cost_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "minute",
        "second",
        "token",
        "character",
        "megabyte",
        "request",
        "seat",
        "flat"
      ]
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "unit_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "amount_usd": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "source": {
      "type": "string",
      "enum": [
        "measured",
        "provider_reported",
        "estimated"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "cost_event_id",
    "tenant_id",
    "session_id",
    "provider_id",
    "service",
    "unit_type",
    "quantity",
    "unit_cost_usd",
    "amount_usd",
    "currency",
    "source",
    "occurred_at"
  ]
}
