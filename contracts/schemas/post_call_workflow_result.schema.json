{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/post_call_workflow_result.schema.json",
  "title": "Post Call Workflow Result",
  "description": "Restricted deterministic summary, structural evaluation and non-effect follow-up guard for M1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "tenant_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "workflow_run_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "command_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "source_event_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "source_event_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_aggregate_version": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "source_state_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
    "correlation_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "causation_id": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        { "type": "null" }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template_code": { "type": "string", "const": "deterministic_session_summary_v1" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "canonical_event_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "final_state_version": { "type": "integer", "minimum": 1, "maximum": 10000000 }
      },
      "required": ["template_code", "text", "canonical_event_count", "final_state_version"]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluator_version": { "type": "string", "const": "fake-structural-v1" },
        "outcome": { "type": "string", "enum": ["passed", "review_required"] },
        "score_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "evidence_event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
        }
      },
      "required": ["evaluator_version", "outcome", "score_basis_points", "evidence_event_ids"]
    },
    "follow_up_guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "mode": { "type": "string", "const": "deterministic_noop" },
        "status": { "type": "string", "const": "not_sent" },
        "external_effect": { "type": "boolean", "const": false },
        "effect_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["command_id", "mode", "status", "external_effect", "effect_hash"]
    },
    "result_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completed_at": { "type": "string", "format": "date-time" },
    "data_classification": { "type": "string", "const": "restricted" }
  },
  "required": [
    "schema_version", "tenant_id", "session_id", "workflow_run_id", "command_id",
    "source_event_id", "source_event_fingerprint", "source_aggregate_version",
    "source_state_hash", "trace_id", "correlation_id", "causation_id", "summary",
    "evaluation", "follow_up_guard", "result_hash", "completed_at",
    "data_classification"
  ]
}
