{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/event_envelope.schema.json",
  "title": "Event Envelope",
  "description": "Versioned event envelope used by outbox and event consumers.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "trace_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "payload_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 250000,
      "contentMediaType": "application/json"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "event_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "tenant_id",
    "session_id",
    "producer",
    "trace_id",
    "correlation_id",
    "causation_id",
    "data_classification",
    "payload_json",
    "occurred_at"
  ]
}
