{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/tool_execution_receipt.schema.json",
  "title": "Tool Execution Receipt",
  "description": "Auditable proof of a tool execution or uncertain effect.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "succeeded",
        "failed",
        "pending",
        "unknown",
        "cancelled"
      ]
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "result_json": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200000,
      "contentMediaType": "application/json"
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "retryable": {
              "type": "boolean"
            },
            "provider_code": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "provider_code"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effect_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "execution_id",
    "intent_id",
    "tenant_id",
    "status",
    "provider_id",
    "attempt",
    "result_json",
    "error",
    "effect_hash",
    "started_at",
    "completed_at"
  ]
}
