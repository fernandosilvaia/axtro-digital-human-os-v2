{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/skill_pack_manifest.schema.json",
  "title": "Skill Pack Manifest",
  "description": "Installable capability package governed by tools and policies.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "skill_pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 1,
      "maxItems": 100
    },
    "tool_contract_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 100
    },
    "input_schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "output_schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "read_public",
        "read_tenant",
        "read_pii",
        "write_low",
        "write_high",
        "financial",
        "irreversible"
      ]
    },
    "supported_role_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "minItems": 1,
      "maxItems": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "disabled"
      ]
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "skill_pack_id",
    "name",
    "version",
    "description",
    "capabilities",
    "tool_contract_ids",
    "input_schema_ref",
    "output_schema_ref",
    "risk_class",
    "supported_role_types",
    "status",
    "checksum"
  ]
}
