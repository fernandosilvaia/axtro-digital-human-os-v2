{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/agent_suggestion.schema.json",
  "title": "Agent Suggestion",
  "description": "Non-authoritative suggestion delivered to the Presenter lane.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "suggestion_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_agent_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "suggestion_type": {
      "type": "string",
      "enum": [
        "next_question",
        "strategy",
        "risk",
        "handoff",
        "scene",
        "tool",
        "fact_check"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 100
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "suggestion_id",
    "session_id",
    "tenant_id",
    "source_agent_type",
    "suggestion_type",
    "content",
    "confidence",
    "evidence_refs",
    "priority",
    "created_at",
    "expires_at"
  ]
}
