{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axtro.ai/v2/workflow_command.schema.json",
  "title": "Workflow Command",
  "description": "Explicit command to start or signal a durable workflow.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workflow_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "input_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200000,
      "contentMediaType": "application/json"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "tenant_id",
    "workflow_type",
    "workflow_version",
    "aggregate_type",
    "aggregate_id",
    "input_json",
    "idempotency_key",
    "requested_by",
    "scheduled_at",
    "created_at"
  ]
}
