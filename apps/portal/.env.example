NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only: chave do OpenRouter (Doppler axtro-human-digital-os > OPEN_ROUTER_API_KEY)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Server-only: conta de demonstracao compartilhada (Doppler axtro-human-digital-os > DEMO_PASSWORD)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=troque-esta-senha

# Server-only: video conversacional (Doppler axtro-human-digital-os > TAVUS_API_KEY)
TAVUS_API_KEY=sua-chave-tavus
TAVUS_REPLICA_ID=r6ae5b6efc9d

# Server/persona-only: voz brasileira via ElevenLabs (Doppler axtro-human-digital-os > ELEVENLABS_API_KEY).
# Usada pela persona Tavus da Aurora (TTS), nao lida diretamente pelo portal.
ELEVENLABS_API_KEY=sua-chave-elevenlabs

# Server-only: e-mail transacional de convite de equipe (Doppler axtro-human-digital-os > RESEND_API_KEY).
# Sem a chave, o convite continua funcionando e o envio vira mock logado.
RESEND_API_KEY=sua-chave-resend
# URL publica do portal usada nos links de e-mail.
PORTAL_PUBLIC_URL=https://portal-production-b43e.up.railway.app

# Modo demonstracao sem chaves: chat deterministico, embeddings fake e
# apresentacao simulada. Usado pelo e2e (pnpm --filter @axtro/portal run e2e).
PORTAL_FAKE_PROVIDERS=0
