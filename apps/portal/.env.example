NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only, NUNCA exposta ao cliente: ignora RLS. Usada só pelo endpoint
# do cerebro customizado (M4-04, /api/brain/[agentId]/chat/completions) para
# resolver o segredo do agente sem sessao de usuario (chamada
# servidor-a-servidor do Tavus). Pegar em Project Settings > API do Supabase
# (Doppler axtro-human-digital-os > SUPABASE_SERVICE_ROLE_KEY). Ate hoje
# nenhum outro caminho do portal usa isso — nao introduza um segundo uso sem
# necessidade (Constituicao Art. 9: isolamento de tenant e controle de
# seguranca, cada chamada deve filtrar tenant_id explicitamente).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here
# Identidade imutavel do deployment usada para cercar heartbeats financeiros.
# Railway injeta RAILWAY_GIT_COMMIT_SHA automaticamente. Em outro runtime,
# defina um identificador novo e imutavel a cada release (8-128 caracteres).
AXTRO_DEPLOYMENT_ID=

# Server-only: segredo estático único que autentica o control-tower chamando
# POST /api/leads/video-session (a ligação de voz da Raissa pedindo a sala de
# vídeo pro lead na hora). NÃO é por agente/tenant como o M4 — só existe um
# chamador conhecido. Gerar com `openssl rand -hex 32` e configurar o MESMO
# valor nos dois lados (aqui e no control-tower).
RAISSA_TOOLS_SECRET=gere-com-openssl-rand-hex-32
# Server-only: leva o agente pra reuniões externas de verdade (Zoom/Meet/Teams)
# via Recall.ai — capacidade central do produto (D-V2-089), disponível pra
# qualquer cliente (Doppler axtro-human-digital-os > RECALL_API_KEY).
RECALL_API_KEY=sua-chave-recall
# A API do Recall.ai e sharded por regiao (us-east-1 | us-west-2 | eu-central-1
# | ap-northeast-1) — visivel no dashboard da conta. Nao adivinhe: usar a
# regiao errada faz toda chamada falhar.
RECALL_API_REGION=us-west-2
# Obrigatorio em modo real: segredo do workspace (Recall.ai dashboard >
# Developers > API Keys & Secrets) que verifica a assinatura HMAC nos
# cabecalhos webhook-id/webhook-timestamp/webhook-signature. O antigo bearer
# em query string foi aposentado e e ignorado pela rota M5-01.
RECALL_WEBHOOK_SECRET=whsec_gerado-no-dashboard-recall
# Hostnames EXATOS autorizados para baixar a URL assinada do transcript.
# Sem wildcard, IP, porta ou URL completa. Confirme os hosts observados na
# conta/regiao antes de ativar; uma allowlist vazia falha fechada.
RECALL_TRANSCRIPT_DOWNLOAD_HOSTS=recallai-production-bot-data.s3.amazonaws.com

# O callback Tavus usa uma capability aleatoria exclusiva por conversa. O
# valor bruto existe apenas na callback_url; somente o SHA-256 fica no banco.
# Nao configure o antigo TAVUS_WEBHOOK_TOKEN global: ele foi aposentado.

# Server-only: PIN da agente institucional que atende /api/leads/video-session
# (a Raissa da plataforma). Sem o pin, a rota cai num fallback deterministico
# (linha 'platform' mais antiga), mas o pin e a proteção real contra
# sequestro da resolução (auditoria 2026-08-02, D-V2-100).
RAISSA_VIDEO_AGENT_ID=019f6de0-0000-7000-8000-00000aa00001

# Server-only: chave do OpenRouter (Doppler axtro-human-digital-os > OPEN_ROUTER_API_KEY)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
AI_USAGE_RECONCILE_SECRET=gere-com-openssl-rand-hex-32

# Server-only: conta de demonstracao compartilhada (Doppler axtro-human-digital-os > DEMO_PASSWORD)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=troque-esta-senha

# Server-only: video conversacional (Doppler axtro-human-digital-os > TAVUS_API_KEY)
TAVUS_API_KEY=sua-chave-tavus
TAVUS_REPLICA_ID=r6ae5b6efc9d

# Server/persona-only: voz brasileira via ElevenLabs (Doppler axtro-human-digital-os > ELEVENLABS_API_KEY).
# Usada pela persona Tavus da Aurora (TTS), nao lida diretamente pelo portal.
ELEVENLABS_API_KEY=sua-chave-elevenlabs
# Voz padrao das personas auto-provisionadas (default: voz Raissa pt-BR).
ELEVENLABS_VOICE_ID=jXrDvfgyizjxORhXsh4y

# Server-only: e-mail transacional de convite de equipe (Doppler axtro-human-digital-os > RESEND_API_KEY).
# Sem a chave, o convite continua funcionando e o envio vira mock logado.
RESEND_API_KEY=sua-chave-resend
# Origem publica server-only usada em callbacks e links. Em modo real ela e
# obrigatoria e aceita somente a raiz HTTPS de um host revisado, sem porta,
# credenciais, path, query ou fragmento. Host canonico atual:
PORTAL_PUBLIC_URL=https://closer.axtroai.com

# Modo demonstracao sem chaves: chat deterministico, embeddings fake e
# apresentacao simulada. Usado pelo e2e (pnpm --filter @axtro/portal run e2e).
PORTAL_FAKE_PROVIDERS=0

# ADR-038: bloqueia por padrao toda criacao de canal Tavus/Recall que ainda
# nao tenha session, disclosure e consentimento duraveis. So use true depois
# de aplicar 0043, validar /api/ready e concluir o canario humano do runbook
# M5-02; nunca habilite para restaurar o caminho legado.
PORTAL_RUNTIME_BRIDGE_ENABLED=false

# D-V2-136: bloqueia por padrao a acao "encerrar agora" (stop) de conversas
# Tavus/reunioes Recall. So use true depois de aplicar 0046, validar
# version:46/providerEffectTerminationFence em /api/ready e concluir o
# canario de terminacao do runbook M5-02; o aceite do provider nao prova
# silencio fisico de midia tardia (P0 de media boundary continua aberto).
PORTAL_PROVIDER_TERMINATION_ENABLED=false

# ADR-039 (onda 1a): bloqueia por padrao toda admissao de BusinessActionIntent
# (register_lead nesta onda; propose_meeting_slots/confirm_meeting_slot ficam
# para a onda 1b). Flag nova e independente de PORTAL_RUNTIME_BRIDGE_ENABLED
# -- nao liga nem desliga o canal de video. So use true depois de aplicar
# 0049, validar version:49 em /api/ready e concluir o canario humano de
# tenant aprovado; nenhuma tool call real do modelo esta ligada ainda
# (apps/portal/src/lib/brain/metodo-silva.ts e video-conversation.ts
# permanecem fora do escopo desta onda).
PORTAL_BUSINESS_ACTION_BRIDGE_ENABLED=false

# ADR-039 (onda 1b-ii): credenciais REAIS do cliente OAuth do Google Calendar
# -- so o Fernando pode criar. Google Cloud Console > APIs & Services >
# Credentials > Create Credentials > OAuth client ID > tipo "Web application",
# com o redirect URI EXATO desta rota cadastrado la:
# https://closer.axtroai.com/api/google-calendar/oauth/callback (o mesmo
# host de PORTAL_PUBLIC_URL acima, path fixo). Sem as duas variaveis (e fora
# de PORTAL_FAKE_PROVIDERS=1), o botao "Conectar Google Calendar" em
# Configuracoes falha fechado com calendar_error=nao_configurado. O app
# provavelmente vai precisar passar pela revisao de app do Google (OAuth
# consent screen > verificacao de escopos sensiveis de Calendar) antes de
# sair do modo de teste interno -- trabalho manual do Fernando, fora do
# escopo do codigo desta onda (ver docs/NEEDS_CONNECTION.md).
GOOGLE_OAUTH_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=seu-client-secret-google

# URL publica do portal para SEO/AEO (canonical, Open Graph, sitemap, llms.txt).
# Variavel separada de PORTAL_PUBLIC_URL (usada nos links de e-mail) porque
# esta e NEXT_PUBLIC_ (exposta ao cliente) — mantenha as duas sincronizadas
# se o dominio publico mudar.
NEXT_PUBLIC_SITE_URL=https://closer.axtroai.com

# Cobranca dos planos (D-V2-101, Doppler axtro-human-digital-os > STRIPE_*).
# Comece SEMPRE com uma chave sk_test_ — scripts/stripe_setup.mjs recusa
# chave sk_live_ (gate humano: chave real de producao exige autorizacao
# explicita do Fernando, ver CLAUDE.md da raiz AxtroAI).
STRIPE_SECRET_KEY=sk_test_sua-chave-stripe
# Endpoint secret do webhook (dashboard.stripe.com/test/webhooks > seu endpoint > Signing secret).
STRIPE_WEBHOOK_SECRET=whsec_gerado-no-dashboard-stripe
# event_name do Billing Meter compartilhado — gerado por scripts/stripe_setup.mjs;
# so precisa mudar se voce recriar o meter com outro nome.
STRIPE_CONVERSATION_OVERAGE_EVENT_NAME=axtro_conversation_overage
# O dispatcher duravel fica inerte por padrao. Em modo provider real,
# /api/ready exige `true`, chave Stripe e segredo do worker; habilite somente
# depois das migrations 0040/0041 e do teste manual do workflow.
BILLING_USAGE_OUTBOX_ENABLED=false
BILLING_DISPATCH_SECRET=gere-com-openssl-rand-hex-32
# Reconciliacao automatica de efeitos Tavus/Recall ambiguos. Em modo real,
# readiness exige `true`; em fake/local pode permanecer desligada. Este
# segredo autoriza SOMENTE o worker automatico; a rota manual retorna 404.
PROVIDER_EFFECT_RECONCILER_ENABLED=false
PROVIDER_EFFECT_RECONCILE_SECRET=gere-com-openssl-rand-hex-32
# Price ids dos 3 planos — gerados por scripts/stripe_setup.mjs (ver o output
# do script para colar os valores reais aqui).
STRIPE_PRICE_PILOTO_BASE=price_gerado-pelo-setup
STRIPE_PRICE_PILOTO_OVERAGE=price_gerado-pelo-setup
STRIPE_PRICE_CRESCIMENTO_BASE=price_gerado-pelo-setup
STRIPE_PRICE_CRESCIMENTO_OVERAGE=price_gerado-pelo-setup
STRIPE_PRICE_ESCALA_BASE=price_gerado-pelo-setup
STRIPE_PRICE_ESCALA_OVERAGE=price_gerado-pelo-setup
# Teto mensal de conversas pra contas SEM assinatura (trial). Ativo por
# padrao desde D-V2-112; use false somente como excecao operacional explicita.
BILLING_TRIAL_LIMIT_ENABLED=true
