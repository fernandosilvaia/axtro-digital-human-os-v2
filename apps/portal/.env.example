NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only, NUNCA exposta ao cliente: ignora RLS. Usada só pelo endpoint
# do cerebro customizado (M4-04, /api/brain/[agentId]/chat/completions) para
# resolver o segredo do agente sem sessao de usuario (chamada
# servidor-a-servidor do Tavus). Pegar em Project Settings > API do Supabase
# (Doppler axtro-human-digital-os > SUPABASE_SERVICE_ROLE_KEY). Ate hoje
# nenhum outro caminho do portal usa isso — nao introduza um segundo uso sem
# necessidade (Constituicao Art. 9: isolamento de tenant e controle de
# seguranca, cada chamada deve filtrar tenant_id explicitamente).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# Server-only: segredo estático único que autentica o control-tower chamando
# POST /api/leads/video-session (a ligação de voz da Raissa pedindo a sala de
# vídeo pro lead na hora). NÃO é por agente/tenant como o M4 — só existe um
# chamador conhecido. Gerar com `openssl rand -hex 32` e configurar o MESMO
# valor nos dois lados (aqui e no control-tower).
RAISSA_TOOLS_SECRET=gere-com-openssl-rand-hex-32
# Server-only: leva o agente pra reuniões externas de verdade (Zoom/Meet/Teams)
# via Recall.ai — capacidade central do produto (D-V2-089), disponível pra
# qualquer cliente (Doppler axtro-human-digital-os > RECALL_API_KEY).
RECALL_API_KEY=sua-chave-recall
# A API do Recall.ai e sharded por regiao (us-east-1 | us-west-2 | eu-central-1
# | ap-northeast-1) — visivel no dashboard da conta. Nao adivinhe: usar a
# regiao errada faz toda chamada falhar.
RECALL_API_REGION=us-west-2
# Segredo que autentica o webhook do Recall.ai (?token=... na URL configurada
# no dashboard deles — mecanismo oficial deles). Gerar com
# `openssl rand -hex 32`.
RECALL_WEBHOOK_TOKEN=gere-com-openssl-rand-hex-32
# Opcional: segredo do workspace (Recall.ai dashboard > Developers > API Keys
# & Secrets) pra verificar a assinatura HMAC nos cabeçalhos webhook-id/
# webhook-timestamp/webhook-signature (docs.recall.ai/docs/authenticating-
# requests-from-recallai — formato Standard Webhooks/Svix). Sem essa var, o
# webhook segue funcionando só com o token acima.
RECALL_WEBHOOK_SECRET=whsec_gerado-no-dashboard-recall

# Server-only: PIN da agente institucional que atende /api/leads/video-session
# (a Raissa da plataforma). Sem o pin, a rota cai num fallback deterministico
# (linha 'platform' mais antiga), mas o pin e a proteção real contra
# sequestro da resolução (auditoria 2026-08-02, D-V2-100).
RAISSA_VIDEO_AGENT_ID=019f6de0-0000-7000-8000-00000aa00001

# Server-only: chave do OpenRouter (Doppler axtro-human-digital-os > OPEN_ROUTER_API_KEY)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Server-only: conta de demonstracao compartilhada (Doppler axtro-human-digital-os > DEMO_PASSWORD)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=troque-esta-senha

# Server-only: video conversacional (Doppler axtro-human-digital-os > TAVUS_API_KEY)
TAVUS_API_KEY=sua-chave-tavus
TAVUS_REPLICA_ID=r6ae5b6efc9d

# Server/persona-only: voz brasileira via ElevenLabs (Doppler axtro-human-digital-os > ELEVENLABS_API_KEY).
# Usada pela persona Tavus da Aurora (TTS), nao lida diretamente pelo portal.
ELEVENLABS_API_KEY=sua-chave-elevenlabs
# Voz padrao das personas auto-provisionadas (default: voz Raissa pt-BR).
ELEVENLABS_VOICE_ID=jXrDvfgyizjxORhXsh4y

# Server-only: e-mail transacional de convite de equipe (Doppler axtro-human-digital-os > RESEND_API_KEY).
# Sem a chave, o convite continua funcionando e o envio vira mock logado.
RESEND_API_KEY=sua-chave-resend
# URL publica do portal usada nos links de e-mail.
PORTAL_PUBLIC_URL=https://portal-production-b43e.up.railway.app

# Modo demonstracao sem chaves: chat deterministico, embeddings fake e
# apresentacao simulada. Usado pelo e2e (pnpm --filter @axtro/portal run e2e).
PORTAL_FAKE_PROVIDERS=0

# URL publica do portal para SEO/AEO (canonical, Open Graph, sitemap, llms.txt).
# Variavel separada de PORTAL_PUBLIC_URL (usada nos links de e-mail) porque
# esta e NEXT_PUBLIC_ (exposta ao cliente) — mantenha as duas sincronizadas
# se o dominio publico mudar.
NEXT_PUBLIC_SITE_URL=https://portal-production-b43e.up.railway.app
