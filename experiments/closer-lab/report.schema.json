{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic closer comparison artifact",
  "description": "Standalone offline benchmark artifact. Not a public command, event or production approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceKind", "baselineVersion", "candidateVersion", "scenarios", "decision", "requiresHumanReview", "naturalnessMeasured", "productionPromotionAllowed"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceKind": { "const": "synthetic_offline" },
    "baselineVersion": { "type": "string", "maxLength": 100, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "candidateVersion": { "type": "string", "maxLength": 100, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "decision": { "enum": ["blocked_critical_violation", "blocked_regression", "blocked_ambiguous_effect", "ready_for_human_review"] },
    "requiresHumanReview": { "const": true },
    "naturalnessMeasured": { "const": false },
    "productionPromotionAllowed": { "const": false },
    "scenarios": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenarioId", "baselineScore", "candidateScore", "baselineCritical", "candidateCritical", "candidateAmbiguousEffects", "regressions"],
        "properties": {
          "scenarioId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$" },
          "baselineScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "candidateScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "candidateAmbiguousEffects": { "type": "integer", "minimum": 0, "maximum": 128 },
          "baselineCritical": { "$ref": "#/$defs/criticalCodes" },
          "candidateCritical": { "$ref": "#/$defs/criticalCodes" },
          "regressions": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["measured_score_decreased", "new_critical_violation", "lost_confirmed_milestone", "new_ambiguous_effect"] } }
        }
      }
    }
  },
  "$defs": {
    "criticalCodes": { "type": "array", "maxItems": 18, "uniqueItems": true, "items": { "type": "string", "pattern": "^(tenant_mismatch|session_mismatch|conflicting_duplicate|missing_intent|tool_scope_mismatch|invalid_effect|invalid_result|missing_disclosure|missing_essential_consent|evaluation_critical_violation|unsupported_completion:(lead_registered|meeting_confirmed|checkout_link_created|payment_confirmed)|missing_expected_receipt:(lead_registered|meeting_confirmed|checkout_link_created|payment_confirmed))$" } }
  }
}
